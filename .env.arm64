# Fallback for machines whose amd64 emulation cannot run SQL Server 2022 (it exits with
# "Unable to create a new asynchronous I/O context"): Azure SQL Edge is the SQL Server
# engine built for arm64. Use with:  cp .env.arm64 .env && make down
MSSQL_IMAGE=mcr.microsoft.com/azure-sql-edge:latest
MSSQL_PLATFORM=linux/arm64
